# Нормализация переносов строк (Windows-разработка → Linux CI/prod)
* text=auto

# Скрипты Unix — всегда LF (иначе «bad interpreter» на Linux)
*.sh text eol=lf
mvnw text eol=lf
gradlew text eol=lf

# Скрипты Windows — всегда CRLF
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Исходники и конфиги — LF
*.java text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.css text eol=lf
*.sql text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.geojson text eol=lf
*.md text eol=lf
*.svg text eol=lf
*.properties text eol=lf

# Бинарные файлы
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.jar binary
*.pdf binary
*.ttf binary
*.woff binary
*.woff2 binary
